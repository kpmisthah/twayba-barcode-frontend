generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & access
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  WAREHOUSE
  CASHIER
  DRIVER
  VIEWER
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Settings & sequences
// ---------------------------------------------------------------------------

/// Key/value settings, e.g. pricesIncludeTax, label size.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Named counters for generated codes (product numbers, later invoice numbers).
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

model TaxRate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  /// Percentage, e.g. 18.00
  rate      Decimal  @db.Decimal(5, 2)
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("tax_rates")
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

enum ProductType {
  STANDARD
  KIT
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  /// Sequential number used to build internal codes (TW-000123).
  number      Int           @unique
  name        String
  description String?
  type        ProductType
  status      ProductStatus @default(ACTIVE)
  categoryId  String?       @db.Uuid
  category    Category?     @relation(fields: [categoryId], references: [id])
  brand       String?
  taxRateId   String?       @db.Uuid
  taxRate     TaxRate?      @relation(fields: [taxRateId], references: [id])
  /// Low-stock threshold, applied per stocked variant.
  minStock    Int           @default(0)
  /// Relative URLs of uploaded images; first one is the main image.
  images      String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants ProductVariant[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

/// STANDARD: a normal sellable, stocked item (one per colour/size).
/// KIT: the sellable kit unit — priced, never stocked or scanned itself.
/// COMPONENT: one box of a kit — stocked and scanned, not priced.
enum VariantKind {
  STANDARD
  KIT
  COMPONENT
}

/// Every SKU. Stock (later phases) is always held against a STANDARD or COMPONENT variant.
model ProductVariant {
  id        String      @id @default(uuid()) @db.Uuid
  productId String      @db.Uuid
  product   Product     @relation(fields: [productId], references: [id])
  kind      VariantKind
  /// Internal code, generated and never changed (TW-000123, TW-000123-01, TW-000200-A).
  code      String      @unique
  sku       String      @unique
  /// Display name: "Default", "Black / Large", "Box A – Side panels".
  name      String
  color     String?
  size      String?
  price     Decimal?    @db.Decimal(12, 2)
  costPrice Decimal?    @db.Decimal(12, 2)
  active    Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  barcodes   Barcode[]
  /// For a KIT variant: the boxes it is made of.
  components KitComponent[] @relation("KitParent")
  /// For a COMPONENT variant: the kits it belongs to.
  usedInKits KitComponent[] @relation("KitPart")

  @@index([productId])
  @@map("product_variants")
}

model KitComponent {
  id                 String         @id @default(uuid()) @db.Uuid
  kitVariantId       String         @db.Uuid
  kitVariant         ProductVariant @relation("KitParent", fields: [kitVariantId], references: [id])
  componentVariantId String         @db.Uuid
  componentVariant   ProductVariant @relation("KitPart", fields: [componentVariantId], references: [id])
  /// How many of this box one kit unit needs.
  quantity           Int

  @@unique([kitVariantId, componentVariantId])
  @@map("kit_components")
}

enum BarcodeType {
  INTERNAL
  SUPPLIER
}

/// A code is unique forever: deactivated codes stay here so they can never be
/// reassigned to another item.
model Barcode {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  variantId     String         @db.Uuid
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  type          BarcodeType
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  deactivatedAt DateTime?

  @@index([variantId])
  @@map("barcodes")
}

// ---------------------------------------------------------------------------
// Audit log — append only, never updated or deleted
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
