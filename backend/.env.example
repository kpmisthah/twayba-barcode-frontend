DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/twayba_ims"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
SEED_ADMIN_EMAIL="admin@twayba.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
UPLOAD_DIR="uploads"
# Number of proxies in front of the API (0 locally; 1 on Render). Makes rate limits per client.
TRUST_PROXY_HOPS=0
# Shared secret the website sends (X-Webhook-Secret) with new orders. Leave empty to disable.
WEBHOOK_SECRET=""
